# GESTOR DE SOLICITUDES — Variables de Entorno

# Requisitos para levantar el proyecto backend:
#   1. Copiar este archivo: cp .env.example .env
#   2. Editar .env con tus valores reales


# Spring Boot — General
SPRING_APPLICATION_NAME=solicitudes-backend
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=default # cambia el perfil de ejecución: default | docker | prod | test


# Base de Datos — H2 (Desarrollo / Default, posible Postgres a futuro en Producción)
SPRING_DATASOURCE_URL=jdbc:h2:mem:solicitudesdb;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE # swap a PostgreSQL sin tocar código
SPRING_DATASOURCE_DRIVERCLASSNAME=org.h2.Driver
SPRING_DATASOURCE_USERNAME=hectorsum
SPRING_DATASOURCE_PASSWORD=

# JPA / Hibernate
SPRING_JPA_HIBERNATE_DDL_AUTO=create-drop # create-drop (dev) vs update (prod)
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.H2Dialect # va ligado al driver

# Para PostgreSQL: org.hibernate.dialect.PostgreSQLDialect
SPRING_JPA_SHOW_SQL=false # En true imprime cada query SQL en los logs (útil para debug)

# Docker (para CI/CD o builds automatizados)
DOCKER_IMAGE_NAME=solicitudes-api
DOCKER_IMAGE_TAG=latest # DOCKER_REGISTRY=ghcr.io/hectorsum
